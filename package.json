{
  "name": "duelwords-av",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "pnpm run config:ios:check:dev && DUELWORDSAV_IOS_BUILD_VARIANT=development expo run:ios",
    "web": "expo start --web --port 8098",
    "config:ios:check": "node scripts/check-ios-release-config.mjs",
    "config:ios:check:dev": "DUELWORDSAV_IOS_BUILD_VARIANT=development node scripts/check-ios-release-config.mjs --development",
    "config:ios:check:preview": "node scripts/check-ios-release-config.mjs --require-preview-runtime",
    "config:ios:generate:dev": "bash scripts/ios/generate-local-xcconfig.sh --env dev",
    "config:ios:generate:preview": "bash scripts/ios/generate-local-xcconfig.sh --env preview",
    "config:ios:generate:prod": "bash scripts/ios/generate-local-xcconfig.sh --env prod",
    "config:ios:runtime:dev": "bash scripts/ios/check-runtime-config.sh --env dev",
    "config:ios:runtime:preview": "bash scripts/ios/check-runtime-config.sh --env preview",
    "config:ios:runtime:prod": "bash scripts/ios/check-runtime-config.sh --env prod",
    "config:ios:built-account": "node scripts/ios/check-built-account-config.mjs",
    "dictionary:generate": "node scripts/generate-local-dictionaries.mjs",
    "dictionary:generate:gaia": "node scripts/generate-gaia-local-dictionaries.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm run config:ios:check && pnpm run typecheck && pnpm run test",
    "lint": "expo lint",
    "doctor:react": "pnpm dlx react-doctor@latest . --verbose",
    "doctor:react:diff": "pnpm dlx react-doctor@latest . --verbose --scope changed",
    "doctor:react:score": "pnpm dlx react-doctor@latest . --score",
    "web:edge:check": "wrangler deploy --dry-run --config web-edge/wrangler.production.jsonc",
    "web:edge:check:preview": "wrangler deploy --dry-run --config web-edge/wrangler.preview.jsonc",
    "legal:edge:check": "wrangler deploy --dry-run --config legal-edge/wrangler.production.jsonc",
    "legal:edge:check:preview": "wrangler deploy --dry-run --config legal-edge/wrangler.preview.jsonc",
    "deploy:preview": "node -e \"throw new Error('DuelWords AV preview deploy is blocked until an approved deploy runbook exists.')\"",
    "testflight": "node -e \"throw new Error('DuelWords AV TestFlight upload requires the private internal-TestFlight runbook and explicit approval for the exact build.')\""
  },
  "dependencies": {
    "@clerk/expo": "4.0.3",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.7",
    "@expo/ui": "~57.0.7",
    "@sentry/react-native": "~7.11.0",
    "convex": "1.42.1",
    "expo": "~57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.5",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.4",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0",
    "wrangler": "4.106.0"
  }
}
